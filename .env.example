# Genie agent that searches the course books
GENIE_SPACE_ID=01f1e49951b91151bc1e88b97cc6517a

# Local dev: uses this CLI profile (host from ~/.databrickscfg, token via `databricks auth token`)
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Deployed: set both instead of using a profile
# DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
# DATABRICKS_TOKEN=

PORT=3000

# Vector Search mode (Lakebase pgvector + foundation model)
LAKEBASE_ENDPOINT=projects/shared/branches/production/endpoints/primary
PGDATABASE=textbooks
# Must match the model that built the stored vectors
EMBEDDING_ENDPOINT=databricks-gte-large-en
# Default answer model, plus the models offered in the Vector Search dropdown ("endpoint=Label", comma-separated)
# Ids are serving endpoint names, or Unity Gateway model services as catalog.schema.service
RAG_CHAT_ENDPOINT=scott.default.textbook
RAG_CHAT_MODELS=scott.default.textbook=Luna 6,databricks-gpt-6-1-terra=Terra 6.1,databricks-gpt-5-4-mini=GPT 5.4 mini
RAG_TOP_K=6
# Reasoning effort for Luna is picked per question by ai_decide (REST API, Beta).
# ai_decide | fixed
RAG_EFFORT_STRATEGY=ai_decide
# Used when strategy is "fixed" or ai_decide fails/times out: none | low | medium | high | xhigh
RAG_REASONING_EFFORT=medium
RAG_EFFORT_TIMEOUT_MS=8000
# PGHOST= / PGUSER=  (optional overrides; otherwise resolved from the workspace)
